# Variables de entorno requeridas por src/main/resources/application.properties.
# Copiar como .env (ignorado por git) o exportarlas en el sistema/IDE. NUNCA subir valores reales.

# Base de datos PostgreSQL (Neon). Sin DB_USER, ReservarApplicationTests se omite.
DB_USER=
DB_PWORD=

# Cuenta SMTP de Gmail para los correos transaccionales (usar una contraseña de aplicación).
MAIL_USER=
MAIL_PWORD=

# Solo en CI (GitHub Actions secret): token del análisis SonarCloud.
# SONAR_TOKEN=
